NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/vam_hrms
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_DAYS=14
COOKIE_SECURE=false
FRONTEND_ORIGINS=http://localhost:5173,https://android-frontend.vercel.app
DEFAULT_GEOFENCE_RADIUS_METERS=25
MAX_LOCATION_ACCURACY_METERS=100
OFFICE_TIME_ZONE=Asia/Kolkata
BIOMETRIC_PROVIDER=local
# Optional dedicated AES-256 key for face-template encryption (64 hex characters).
# If omitted, development derives a key from JWT_ACCESS_SECRET; set a dedicated key in production.
BIOMETRIC_ENCRYPTION_KEY=
BIOMETRIC_FACE_DISTANCE_THRESHOLD=1.1
BIOMETRIC_LIVENESS_MAX_SCORE=0.2
